{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuma Write",
  "version": "0.2.0",
  "identifier": "app.kumawrite.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kuma Write",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#dde3ea"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
