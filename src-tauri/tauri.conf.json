{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuma Write",
  "mainBinaryName": "kuma-write",
  "version": "0.3.0",
  "identifier": "app.kumawrite.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kuma Write",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#dde3ea"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "沉浸式專注寫作軟體",
    "longDescription": "安靜、留白的全螢幕寫作環境：程式繪製的風景背景、環境音與打字音效、每日寫作統計，以及達成目標前不能離開的「小黑屋」。",
    "copyright": "© 2026 Kuma Write",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
